  {
    "contents": "#pragma once
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <mimalloc.h>

typedef struct Probe_Result Probe_Result;
#include "Item_auto.h"
typedef enum Probe_Result_tag {
  Probe_Result_tag_item,
  Probe_Result_tag_text,
  Probe_Result_tag_count,
  Probe_Result_tag_empty
} Probe_Result_tag;
typedef union Probe_Result_value {
  Probe_Item * item;
  char * text;
  int64_t count;
  unsigned char empty;
} Probe_Result_value;
struct Probe_Result {
  Probe_Result_tag tag;
  Probe_Result_value value;
};
const char *Probe_Result_tag_to_string(Probe_Result_tag tag);
Probe_Result *Probe_Result_parse(mi_heap_t *arena, const char *tag, const Probe_Result_value *value);
Probe_Result *Probe_Result_create(mi_heap_t *arena, const Probe_Result *input);
Probe_Result *Probe_Result_create_item(mi_heap_t *arena, Probe_Item * value);
Probe_Result *Probe_Result_create_text(mi_heap_t *arena, char * value);
Probe_Result *Probe_Result_create_count(mi_heap_t *arena, int64_t value);
Probe_Result *Probe_Result_create_empty(mi_heap_t *arena);
typedef struct Probe_Result_cases {
  void (*item)(void *context, Probe_Item * value);
  void (*text)(void *context, char * value);
  void (*count)(void *context, int64_t value);
  void (*empty)(void *context);
} Probe_Result_cases;
#define Probe_Result_cases_init(item, text, count, empty) ((Probe_Result_cases){ item, text, count, empty })
void Probe_Result_match(const Probe_Result *input, void *context, const Probe_Result_cases *cases);
",
    "path": "Probe/Result_auto.h",
  },
  {
    "contents": "#include "Item_auto.h"
#include "Result_auto.h"
#include <string.h>

const char *Probe_Result_tag_to_string(Probe_Result_tag tag) {
  switch (tag) {
    case Probe_Result_tag_item: return "item";
    case Probe_Result_tag_text: return "text";
    case Probe_Result_tag_count: return "count";
    case Probe_Result_tag_empty: return "empty";
  }
  return NULL;
}

Probe_Result *Probe_Result_create(mi_heap_t *arena, const Probe_Result *input) {
  if (!arena || !input) return NULL;
  Probe_Result *out = mi_heap_zalloc(arena, sizeof(*out));
  if (!out) return NULL;
  out->tag = input->tag;
  switch (input->tag) {
    case Probe_Result_tag_item:
      out->value.item = Probe_Item_create(arena, input->value.item);
      if (input->value.item && !out->value.item) return NULL;
      break;
    case Probe_Result_tag_text:
      out->value.text = input->value.text ? mi_heap_strdup(arena, input->value.text) : NULL;
      if (input->value.text && !out->value.text) return NULL;
      break;
    case Probe_Result_tag_count:
      out->value.count = input->value.count;
      break;
    case Probe_Result_tag_empty:
      out->value.empty = 0;
      break;
    default: return NULL;
  }
  return out;
}

Probe_Result *Probe_Result_parse(mi_heap_t *arena, const char *tag, const Probe_Result_value *value) {
  if (!arena || !tag || !value) return NULL;
  Probe_Result input = {0};
  if (strcmp(tag, "item") == 0) input.tag = Probe_Result_tag_item;
  else if (strcmp(tag, "text") == 0) input.tag = Probe_Result_tag_text;
  else if (strcmp(tag, "count") == 0) input.tag = Probe_Result_tag_count;
  else if (strcmp(tag, "empty") == 0) input.tag = Probe_Result_tag_empty;
  else return NULL;
  input.value = *value;
  return Probe_Result_create(arena, &input);
}

Probe_Result *Probe_Result_create_item(mi_heap_t *arena, Probe_Item * value) {
  Probe_Result_value payload = { .item = value };
  return Probe_Result_parse(arena, "item", &payload);
}

Probe_Result *Probe_Result_create_text(mi_heap_t *arena, char * value) {
  Probe_Result_value payload = { .text = value };
  return Probe_Result_parse(arena, "text", &payload);
}

Probe_Result *Probe_Result_create_count(mi_heap_t *arena, int64_t value) {
  Probe_Result_value payload = { .count = value };
  return Probe_Result_parse(arena, "count", &payload);
}

Probe_Result *Probe_Result_create_empty(mi_heap_t *arena) {
  Probe_Result_value payload = { .empty = 0 };
  return Probe_Result_parse(arena, "empty", &payload);
}

void Probe_Result_match(const Probe_Result *input, void *context, const Probe_Result_cases *cases) {
  switch (input->tag) {
    case Probe_Result_tag_item: cases->item(context, input->value.item); return;
    case Probe_Result_tag_text: cases->text(context, input->value.text); return;
    case Probe_Result_tag_count: cases->count(context, input->value.count); return;
    case Probe_Result_tag_empty: cases->empty(context); return;
  }
}
",
    "path": "Probe/Result_auto.c",
  },
