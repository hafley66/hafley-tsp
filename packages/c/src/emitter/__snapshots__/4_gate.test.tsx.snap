    "contents": "#include "Item_auto.h"
#include <string.h>

Probe_Item *Probe_Item_create(mi_heap_t *arena, const Probe_Item *input) {
  if (!arena || !input) return NULL;
  Probe_Item *out = mi_heap_zalloc(arena, sizeof(*out));
  if (!out) return NULL;
  out->id = input->id;
  out->label = input->label ? mi_heap_strdup(arena, input->label) : NULL;
  if (input->label && !out->label) return NULL;
  out->state = input->state;
  out->has_note = input->has_note;
  if (input->has_note) out->note = input->note ? mi_heap_strdup(arena, input->note) : NULL;
  if (input->has_note && input->note && !out->note) return NULL;
  return out;
}
