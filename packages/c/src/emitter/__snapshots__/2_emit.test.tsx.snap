    "contents": "#pragma once
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <mimalloc.h>

typedef enum State {
  State_active,
  State_inactive
} State;
const char *State_to_string(State value);
State *State_from_string(mi_heap_t *arena, const char *text);
typedef struct State_cases {
  void (*active)(void *context);
  void (*inactive)(void *context);
} State_cases;
#define State_cases_init(active, inactive) ((State_cases){ active, inactive })
void State_match(State value, void *context, const State_cases *cases);
",
    "path": "Probe/State_auto.h",
  },
  {
    "contents": "#include "State_auto.h"
#include <string.h>

static const struct { State value; const char *text; } State_strings[] = {
  { State_active, "active" },
  { State_inactive, "inactive" },
};

const char *State_to_string(State value) {
  for (size_t i = 0; i < sizeof(State_strings) / sizeof(State_strings[0]); ++i) {
    if (State_strings[i].value == value) return State_strings[i].text;
  }
  return NULL;
}

State *State_from_string(mi_heap_t *arena, const char *text) {
  if (!arena || !text) return NULL;
  for (size_t i = 0; i < sizeof(State_strings) / sizeof(State_strings[0]); ++i) {
    if (strcmp(State_strings[i].text, text) == 0) {
      State *out = mi_heap_malloc(arena, sizeof(*out));
      if (out) *out = State_strings[i].value;
      return out;
    }
  }
  return NULL;
}

void State_match(State value, void *context, const State_cases *cases) {
  switch (value) {
    case State_active: cases->active(context); return;
    case State_inactive: cases->inactive(context); return;
  }
}
