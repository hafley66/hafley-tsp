  {
    "contents": "#pragma once
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <mimalloc.h>

typedef struct Result Result;
#include "Item_auto.h"
typedef enum Result_tag {
  Result_tag_item,
  Result_tag_text,
  Result_tag_count,
  Result_tag_empty
} Result_tag;
typedef union Result_value {
  Item * item;
  char * text;
  int64_t count;
  unsigned char empty;
} Result_value;
struct Result {
  Result_tag tag;
  Result_value value;
};
const char *Result_tag_to_string(Result_tag tag);
Result *Result_parse(mi_heap_t *arena, const char *tag, const Result_value *value);
Result *Result_create(mi_heap_t *arena, const Result *input);
Result *Result_create_item(mi_heap_t *arena, Item * value);
Result *Result_create_text(mi_heap_t *arena, char * value);
Result *Result_create_count(mi_heap_t *arena, int64_t value);
Result *Result_create_empty(mi_heap_t *arena);
typedef struct Result_cases {
  void (*item)(void *context, Item * value);
  void (*text)(void *context, char * value);
  void (*count)(void *context, int64_t value);
  void (*empty)(void *context);
} Result_cases;
#define Result_cases_init(item, text, count, empty) ((Result_cases){ item, text, count, empty })
void Result_match(const Result *input, void *context, const Result_cases *cases);
",
    "path": "Probe/Result_auto.h",
  },
  {
    "contents": "#include "Item_auto.h"
#include "Result_auto.h"
#include <string.h>

const char *Result_tag_to_string(Result_tag tag) {
  switch (tag) {
    case Result_tag_item: return "item";
    case Result_tag_text: return "text";
    case Result_tag_count: return "count";
    case Result_tag_empty: return "empty";
  }
  return NULL;
}

Result *Result_create(mi_heap_t *arena, const Result *input) {
  if (!arena || !input) return NULL;
  Result *out = mi_heap_zalloc(arena, sizeof(*out));
  if (!out) return NULL;
  out->tag = input->tag;
  switch (input->tag) {
    case Result_tag_item:
      out->value.item = Item_create(arena, input->value.item);
      if (input->value.item && !out->value.item) return NULL;
      break;
    case Result_tag_text:
      out->value.text = input->value.text ? mi_heap_strdup(arena, input->value.text) : NULL;
      if (input->value.text && !out->value.text) return NULL;
      break;
    case Result_tag_count:
      out->value.count = input->value.count;
      break;
    case Result_tag_empty:
      out->value.empty = 0;
      break;
    default: return NULL;
  }
  return out;
}

Result *Result_parse(mi_heap_t *arena, const char *tag, const Result_value *value) {
  if (!arena || !tag || !value) return NULL;
  Result input = {0};
  if (strcmp(tag, "item") == 0) input.tag = Result_tag_item;
  else if (strcmp(tag, "text") == 0) input.tag = Result_tag_text;
  else if (strcmp(tag, "count") == 0) input.tag = Result_tag_count;
  else if (strcmp(tag, "empty") == 0) input.tag = Result_tag_empty;
  else return NULL;
  input.value = *value;
  return Result_create(arena, &input);
}

Result *Result_create_item(mi_heap_t *arena, Item * value) {
  Result_value payload = { .item = value };
  return Result_parse(arena, "item", &payload);
}

Result *Result_create_text(mi_heap_t *arena, char * value) {
  Result_value payload = { .text = value };
  return Result_parse(arena, "text", &payload);
}

Result *Result_create_count(mi_heap_t *arena, int64_t value) {
  Result_value payload = { .count = value };
  return Result_parse(arena, "count", &payload);
}

Result *Result_create_empty(mi_heap_t *arena) {
  Result_value payload = { .empty = 0 };
  return Result_parse(arena, "empty", &payload);
}

void Result_match(const Result *input, void *context, const Result_cases *cases) {
  switch (input->tag) {
    case Result_tag_item: cases->item(context, input->value.item); return;
    case Result_tag_text: cases->text(context, input->value.text); return;
    case Result_tag_count: cases->count(context, input->value.count); return;
    case Result_tag_empty: cases->empty(context); return;
  }
}
",
