    "contents": "#pragma once
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <mimalloc.h>

typedef enum Probe_State {
  Probe_State_active,
  Probe_State_inactive
} Probe_State;
const char *Probe_State_to_string(Probe_State value);
Probe_State *Probe_State_from_string(mi_heap_t *arena, const char *text);
typedef struct Probe_State_cases {
  void (*active)(void *context);
  void (*inactive)(void *context);
} Probe_State_cases;
#define Probe_State_cases_init(active, inactive) ((Probe_State_cases){ active, inactive })
void Probe_State_match(Probe_State value, void *context, const Probe_State_cases *cases);
",
    "path": "Probe/State_auto.h",
  },
  {
    "contents": "#include "State_auto.h"
#include <string.h>

static const struct { Probe_State value; const char *text; } Probe_State_strings[] = {
  { Probe_State_active, "active" },
  { Probe_State_inactive, "inactive" },
};

const char *Probe_State_to_string(Probe_State value) {
  for (size_t i = 0; i < sizeof(Probe_State_strings) / sizeof(Probe_State_strings[0]); ++i) {
    if (Probe_State_strings[i].value == value) return Probe_State_strings[i].text;
  }
  return NULL;
}

Probe_State *Probe_State_from_string(mi_heap_t *arena, const char *text) {
  if (!arena || !text) return NULL;
  for (size_t i = 0; i < sizeof(Probe_State_strings) / sizeof(Probe_State_strings[0]); ++i) {
    if (strcmp(Probe_State_strings[i].text, text) == 0) {
      Probe_State *out = mi_heap_malloc(arena, sizeof(*out));
      if (out) *out = Probe_State_strings[i].value;
      return out;
    }
  }
  return NULL;
}

void Probe_State_match(Probe_State value, void *context, const Probe_State_cases *cases) {
  switch (value) {
    case Probe_State_active: cases->active(context); return;
    case Probe_State_inactive: cases->inactive(context); return;
  }
}
